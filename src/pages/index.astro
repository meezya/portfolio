---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { projects } from '../data/projects';
---

<Layout>
	<SiteHeader home />

	<main class="mx-auto max-w-[1440px] px-5 pb-32 pt-16 sm:px-12 sm:pt-24">
		<ul class="logo-grid grid grid-cols-1 md:grid-cols-[57fr_43fr]">
			{
				projects.map((p) => {
					const linked = p.page !== false;
					const Tag = linked ? 'a' : 'div';
					return (
						<li class="logo-cell">
							<Tag
								href={linked ? `/work/${p.slug}` : undefined}
								class:list={['logo-link group', !linked && 'is-pending']}
								aria-label={linked ? `${p.name}, ${p.kind}` : `${p.name}, coming soon`}
							>
								<img
									src={p.logo.src}
									alt=""
									style={`--w: ${p.logo.width}px`}
									class="logo-img"
									draggable={false}
								/>
								<span class="logo-label font-sans text-xs uppercase tracking-[0.2em] text-neutral-500">
									{p.kind}
								</span>
							</Tag>
						</li>
					);
				})
			}
		</ul>
	</main>
</Layout>

<style>
	/* Each cell is a fixed-height row with the logo vertically centered and
	   left-aligned, matching the Paper "Portfolio — Alt" mockup. */
	.logo-cell {
		display: flex;
		align-items: center;
		height: 200px;
	}
	@media (min-width: 768px) {
		.logo-cell {
			height: 330px;
		}
	}

	.logo-link {
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		transition: opacity 300ms;
	}

	/* Logos render at their designed width on desktop and ~70% on phones,
	   never wider than the cell. */
	.logo-img {
		display: block;
		width: min(calc(var(--w) * 0.7), 100%);
		height: auto;
		user-select: none;
	}
	@media (min-width: 768px) {
		.logo-img {
			width: min(var(--w), 100%);
		}
	}

	/* Project descriptor sits just under the logo, revealed on hover/focus. */
	.logo-label {
		position: absolute;
		top: calc(100% + 20px);
		left: 0;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-4px);
		transition:
			opacity 300ms,
			transform 300ms;
	}
	.logo-link:hover .logo-label,
	.logo-link:focus-visible .logo-label {
		opacity: 1;
		transform: none;
	}

	/* Hovering the grid quiets every logo except the one under the cursor. */
	@media (hover: hover) {
		.logo-grid:has(.logo-link:hover) .logo-link:not(:hover) {
			opacity: 0.25;
		}
	}

	.logo-link:focus-visible {
		outline: 1px solid #737373;
		outline-offset: 16px;
	}

	.is-pending {
		cursor: default;
	}
</style>
