---
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import { sections, type Tile, type Project } from '../data/projects';

// Outer frame for collage tiles: dimensions and optional absolute placement.
// Opacity lives on the inner bg layer so captions stay at full opacity.
function tileFrameStyle(tile: Tile): string {
	const parts = [`width: ${tile.width}px`, `height: ${tile.height}px`];
	if (tile.absolute) {
		parts.push('position: absolute');
		parts.push(`left: ${tile.absolute.left}px`);
		parts.push(`top: ${tile.absolute.top}px`);
	}
	return parts.join('; ');
}

// Inner background layer for collage tiles. Cover-fits the image and, when
// tile.frame is set, takes those exact dimensions and offsets within the tile
// (matches Paper's nested "frame + cover-fit + offset" reframing).
function tileBgStyle(tile: Tile): string {
	const parts = [
		'position: absolute',
		'background-size: cover',
		'background-position: 50%',
		'background-repeat: no-repeat',
	];

	if (tile.frame) {
		parts.push(`left: ${tile.frame.left}px`);
		parts.push(`top: ${tile.frame.top}px`);
		parts.push(`width: ${tile.frame.width}px`);
		parts.push(`height: ${tile.frame.height}px`);
	} else {
		parts.push('inset: 0');
	}

	if (tile.type === 'image') {
		parts.push(`background-image: url(${tile.src})`);
	} else if (tile.type === 'video') {
		const thumb = tile.thumbnail ?? `https://img.youtube.com/vi/${tile.youtubeId}/maxresdefault.jpg`;
		parts.push(`background-image: url(${thumb})`);
	} else if (tile.type === 'pdf') {
		parts.push(`background-image: url(${tile.preview})`);
	}

	if (tile.opacity !== undefined) parts.push(`opacity: ${tile.opacity}`);
	return parts.join('; ');
}

// Per-project heading: a serif display name. Falls back to bold sans when no
// heading font is set.
function headingStyle(p: Project): string | undefined {
	return p.headingFont
		? `font-family: '${p.headingFont}', 'Songti SC', 'Noto Serif SC', serif; font-weight: ${p.headingWeight ?? 400};`
		: undefined;
}

// Render any section that has either projects or gallery tiles.
const visibleSections = sections.filter((s) => {
	if (s.layout === 'gallery') return (s.tiles?.length ?? 0) > 0;
	return s.projects.length > 0;
});
const showNav = visibleSections.length >= 2;
const showSectionLabels = visibleSections.length >= 2;
---

<Layout>
	<div class="page-zoom">
	<header class="mx-auto max-w-[1600px] px-12 pt-24">
		<p class="font-sans text-sm tracking-wide text-neutral-500">Iso Design &amp; Research</p>
		<div class="mt-3 flex items-baseline justify-between">
			<h1
				class="text-3xl"
				style="font-family: 'STSong', 'Songti SC', 'Noto Serif SC', serif; font-weight: 300;"
			>
				Rameez S. Ahmad
			</h1>
			<nav class="flex gap-8 font-sans text-sm">
				{showNav &&
					visibleSections.map((s) => (
						<a
							href={`#${s.id}`}
							class="text-neutral-400 transition-colors hover:text-neutral-100"
						>
							{s.title}
						</a>
					))}
				<a
					href="https://radicalhumanism.co"
					target="_blank"
					rel="noopener"
					class="text-neutral-400 transition-colors hover:text-neutral-100"
				>
					Radical Humanism
				</a>
				<a
					href="mailto:rameez.s.ahmad@gmail.com"
					class="text-neutral-400 transition-colors hover:text-neutral-100"
				>
					Contact
				</a>
			</nav>
		</div>
	</header>

	<main class="mx-auto max-w-[1600px] px-12 py-24">
		{
			visibleSections.map((section, sIdx) => (
				<section
					id={section.id}
					class:list={[sIdx > 0 ? 'mt-32 border-t border-neutral-900 pt-32' : '']}
				>
					{showSectionLabels && (
						<p class="mb-16 font-sans text-xs uppercase tracking-[0.2em] text-neutral-500">
							{section.title}
						</p>
					)}

					{section.layout === 'gallery' && section.tiles && (
						<div data-drag-scroll class="gallery-scroll overflow-x-auto">
							<div class="flex gap-6 pb-4">
								{section.tiles.map((tile, tIdx) => (
									tile.type === 'image' ? (
										<button
											type="button"
											data-tile-project={section.id}
											data-tile-index={tIdx}
											class="tile-wrap relative block h-[420px] flex-shrink-0 cursor-pointer overflow-hidden transition-opacity duration-200"
											aria-label={tile.alt || 'View image'}
										>
											<img
												src={tile.src}
												alt={tile.alt || ''}
												draggable={false}
												class="tile-bg block h-full w-auto max-w-none select-none"
											/>
										</button>
									) : null
								))}
							</div>
						</div>
					)}

					{section.layout !== 'gallery' && (
					<div class="space-y-40">
						{section.projects.map((project) => {
							// ---- Campaign layout: name above, intro column + scroll gallery ----
							if (project.layout === 'campaign' && project.deck && project.gallery) {
								const deck = project.deck;
								const gallery = project.gallery;
								return (
									<article class="flex flex-col gap-10">
										<h2 class="text-4xl" style={headingStyle(project)}>
											{project.name}
										</h2>
										<div class="flex items-start gap-12">
											<div class="flex w-[600px] flex-shrink-0 flex-col gap-8">
												<a
													href={deck.pdf}
													target="_blank"
													rel="noopener"
													class="tile-wrap relative block aspect-video w-full overflow-hidden"
													aria-label={deck.title || 'View PDF'}
												>
													<img
														src={deck.preview}
														alt={deck.title || ''}
														class="tile-bg absolute inset-0 h-full w-full object-cover"
														style="opacity: 0.4"
													/>
													<span class="absolute bottom-3 left-3 right-3 font-sans text-xs uppercase tracking-[0.2em] text-neutral-300">
														{deck.caption ?? 'PDF · Read'}
													</span>
												</a>
												<div class="flex flex-col gap-6">
													{project.body.map((para) => (
														<p class="text-base leading-6 text-neutral-300">{para}</p>
													))}
												</div>
												{project.link && (
													<a
														href={project.link.href}
														target="_blank"
														rel="noopener"
														class="font-sans text-xs uppercase tracking-[0.2em] text-neutral-400 transition-colors hover:text-neutral-100"
													>
														{project.link.label} →
													</a>
												)}
											</div>

											<div data-drag-scroll class="gallery-scroll flex-1 overflow-x-auto">
												<div class="flex gap-6 pb-4">
													{gallery.map((item, i) => (
														<button
															type="button"
															data-tile-project={project.slug}
															data-tile-index={i}
															class="tile-wrap relative block h-[688px] w-[311px] flex-shrink-0 cursor-pointer overflow-hidden"
															aria-label={
																item.type === 'video'
																	? item.title || 'Play video'
																	: item.alt || 'View image'
															}
														>
															<img
																src={
																	item.type === 'image'
																		? item.src
																		: item.thumbnail ?? `https://img.youtube.com/vi/${item.youtubeId}/maxresdefault.jpg`
																}
																alt={item.type === 'image' ? item.alt || '' : item.title || ''}
																draggable={false}
																class="block h-full w-full object-cover select-none"
															/>
															{item.type === 'video' && (
																<span class="absolute inset-0 flex items-center justify-center bg-black/20">
																	<span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 pl-1 text-xl text-black">
																		▶
																	</span>
																</span>
															)}
														</button>
													))}
												</div>
											</div>
										</div>
									</article>
								);
							}

							// ---- Research layout: name above, wide deck cover + body ----
							if (project.layout === 'research' && project.deck) {
								const deck = project.deck;
								return (
									<article class="flex flex-col gap-10">
										<h2 class="text-4xl" style={headingStyle(project)}>
											{project.name}
										</h2>
										<div class="flex items-start gap-12">
											<a
												href={deck.pdf}
												target="_blank"
												rel="noopener"
												class="tile-wrap relative block aspect-video w-[864px] flex-shrink-0 overflow-hidden"
												aria-label={deck.title || 'View PDF'}
											>
												<img
													src={deck.preview}
													alt={deck.title || ''}
													class="tile-bg absolute inset-0 h-full w-full object-cover"
													style="opacity: 0.4"
												/>
												<span class="absolute bottom-3 left-3 right-3 font-sans text-xs uppercase tracking-[0.2em] text-neutral-300">
													{deck.caption ?? 'PDF · Read'}
												</span>
											</a>
											<div class="flex w-[432px] flex-shrink-0 flex-col gap-10 pt-2">
												<div class="flex flex-col gap-6">
													{project.body.map((para) => (
														<p class="text-base leading-6 text-neutral-300">{para}</p>
													))}
												</div>
												{project.link && (
													<a
														href={project.link.href}
														target="_blank"
														rel="noopener"
														class="font-sans text-xs uppercase tracking-[0.2em] text-neutral-400 transition-colors hover:text-neutral-100"
													>
														{project.link.label} →
													</a>
												)}
											</div>
										</div>
									</article>
								);
							}

							// ---- Collage layout (default): media grid + text column ----
							const tiles = project.tiles ?? [];
							let mediaIdx = 0;
							const annotated = tiles.map((tile) => {
								if (tile.type === 'image' || tile.type === 'video') {
									return { tile, mediaIndex: mediaIdx++ };
								}
								return { tile, mediaIndex: null as number | null };
							});

							return (
								<article class="flex items-start gap-12">
									<div class="relative flex w-[864px] flex-shrink-0 flex-wrap gap-6">
										{annotated.map(({ tile, mediaIndex }) => {
											const flowClass = tile.absolute ? '' : 'flex-shrink-0';
											const interactiveClass =
												'tile cursor-pointer transition-opacity duration-200';

											if (tile.type === 'pdf') {
												const pdfCaption = tile.caption ?? 'PDF · Read';
												return (
													<a
														href={tile.pdf}
														target="_blank"
														rel="noopener"
														class:list={['tile-wrap', 'block', flowClass, interactiveClass, 'relative', 'overflow-hidden']}
														style={tileFrameStyle(tile)}
														aria-label={tile.title || 'View PDF'}
													>
														<div class="tile-bg" style={tileBgStyle(tile)}></div>
														{pdfCaption && (
															<span class="absolute bottom-3 left-3 right-3 font-sans text-xs uppercase tracking-[0.2em] text-neutral-300">
																{pdfCaption}
															</span>
														)}
													</a>
												);
											}

											return (
												<button
													type="button"
													data-tile-project={project.slug}
													data-tile-index={mediaIndex}
													class:list={['tile-wrap', 'block', flowClass, interactiveClass, 'relative', 'overflow-hidden']}
													style={tileFrameStyle(tile)}
													aria-label={
														tile.type === 'video'
															? tile.title || 'Play video'
															: tile.alt || 'View image'
													}
												>
													<div class="tile-bg" style={tileBgStyle(tile)}></div>
													{tile.type === 'video' && !tile.caption && (
														<span class="absolute inset-0 flex items-center justify-center bg-black/30">
															<span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 pl-1 text-xl text-black">
																▶
															</span>
														</span>
													)}
													{tile.caption && (
														<span class="absolute bottom-3 left-3 right-3 font-sans text-xs uppercase tracking-[0.2em] text-neutral-300">
															{tile.caption}
														</span>
													)}
												</button>
											);
										})}
									</div>

									<div class="flex w-[432px] flex-shrink-0 flex-col gap-10 pt-2">
										<h2
											class:list={['text-4xl', !project.headingFont && 'font-bold']}
											style={headingStyle(project)}
										>
											{project.name}
										</h2>
										<div class="flex flex-col gap-6">
											{project.body.map((para) => (
												<p class="text-base leading-6 text-neutral-300">{para}</p>
											))}
										</div>
										{project.link && (
											<a
												href={project.link.href}
												target="_blank"
												rel="noopener"
												class="font-sans text-xs uppercase tracking-[0.2em] text-neutral-400 transition-colors hover:text-neutral-100"
											>
												{project.link.label} →
											</a>
										)}
									</div>
								</article>
							);
						})}
					</div>
					)}
				</section>
			))
		}
	</main>

	<footer class="mx-auto max-w-[1600px] border-t border-neutral-900 px-12 py-16">
		<div class="flex justify-center">
			<a
				href="/papers/rameez-ahmad-portfolio.pdf"
				target="_blank"
				rel="noopener"
				class="font-sans text-sm uppercase tracking-[0.2em] text-neutral-400 transition-colors hover:text-neutral-100"
			>
				View Portfolio in PDF →
			</a>
		</div>
	</footer>
	</div>

	<Lightbox sections={sections} />
</Layout>

<style>
	/* Faded tile background ramps to full opacity on hover. Opacity lives on
	   the inner .tile-bg layer so the caption above it stays at full opacity. */
	.tile-bg {
		transition: opacity 200ms;
	}
	.tile-wrap:hover .tile-bg {
		opacity: 1 !important;
	}

	/* Page-level zoom: the layout was designed at 1600px wide. On narrower
	   viewports we scale the whole thing down proportionally so the design
	   stays intact instead of overflowing. Floor at 0.55. */
	@media (max-width: 1600px) {
		.page-zoom {
			zoom: clamp(0.55, calc(100vw / 1600px), 1);
		}
	}

	/* Horizontal-scroll gallery: trackpad-swipe works natively, mouse drag is
	   wired up via the script below. */
	.gallery-scroll {
		cursor: grab;
		scroll-behavior: smooth;
		scrollbar-color: #2d2d2d transparent;
		scrollbar-width: thin;
	}
	.gallery-scroll.is-dragging {
		cursor: grabbing;
		scroll-behavior: auto;
		user-select: none;
	}
	.gallery-scroll.is-dragging img {
		pointer-events: none;
	}
	.gallery-scroll::-webkit-scrollbar {
		height: 6px;
	}
	.gallery-scroll::-webkit-scrollbar-track {
		background: transparent;
	}
	.gallery-scroll::-webkit-scrollbar-thumb {
		background: #2d2d2d;
		border-radius: 3px;
	}
	.gallery-scroll::-webkit-scrollbar-thumb:hover {
		background: #5b5b5b;
	}
</style>

<script is:inline>
	// Mouse-drag horizontal scroll for [data-drag-scroll] containers. Trackpad
	// horizontal scroll already works natively; this is for mouse users. Drags
	// past a small threshold suppress the trailing click so the lightbox
	// doesn't open mid-drag.
	(function () {
		const DRAG_THRESHOLD = 6; // px

		document.querySelectorAll('[data-drag-scroll]').forEach((el) => {
			let isDown = false;
			let startX = 0;
			let startScroll = 0;
			let dragDistance = 0;

			el.addEventListener('mousedown', (e) => {
				if (e.button !== 0) return;
				isDown = true;
				dragDistance = 0;
				startX = e.pageX;
				startScroll = el.scrollLeft;
				el.classList.add('is-dragging');
			});

			const stop = () => {
				if (!isDown) return;
				isDown = false;
				el.classList.remove('is-dragging');
			};

			el.addEventListener('mouseleave', stop);
			el.addEventListener('mouseup', stop);

			el.addEventListener('mousemove', (e) => {
				if (!isDown) return;
				const delta = e.pageX - startX;
				dragDistance = Math.abs(delta);
				el.scrollLeft = startScroll - delta;
			});

			el.addEventListener(
				'click',
				(e) => {
					if (dragDistance > DRAG_THRESHOLD) {
						e.preventDefault();
						e.stopPropagation();
					}
				},
				true,
			);

			el.addEventListener('dragstart', (e) => e.preventDefault());
		});
	})();
</script>
